#!/opt/ovh-api/bin/python
"""Remplace le snapshot OVH du VPS (OVH n en garde qu un) : ovh-snapshot "description".
Refuse de commencer si le VPS n est pas au repos (sauvegarde automatique OVH en cours, etc.),
pour ne jamais supprimer l ancien snapshot sans pouvoir en creer un nouveau."""
import sys, time, ovh
N = "vps-c21dda1c.vps.ovh.ca"
c = ovh.Client(config_file="/etc/ovh.conf")
desc = sys.argv[1] if len(sys.argv) > 1 else time.strftime("snapshot %Y-%m-%d %H:%M")
etat = c.get(f"/vps/{N}").get("state")
if etat != "running":
    sys.exit(f"VPS dans l etat '{etat}' (ex. sauvegarde automatique OVH en cours) : reessayer plus tard. Ancien snapshot conserve.")
try:
    c.delete(f"/vps/{N}/snapshot")
    print("Ancien snapshot en cours de suppression...")
    for _ in range(60):
        time.sleep(10)
        try:
            c.get(f"/vps/{N}/snapshot")
        except ovh.exceptions.ResourceNotFoundError:
            break
except ovh.exceptions.ResourceNotFoundError:
    pass
for i in range(20):
    try:
        c.post(f"/vps/{N}/createSnapshot", description=desc)
        print("Snapshot demande :", desc)
        break
    except ovh.exceptions.APIError as e:
        print("Nouvel essai dans 30 s :", str(e).splitlines()[0]); time.sleep(30)
else:
    sys.exit("ECHEC : aucun snapshot cree, relancer ovh-snapshot")
