#!/bin/bash
# Sauvegarde nocturne du VPS e-delmotte vers OVH Object Storage (Gravelines), chiffrée par restic.
#
# Contenu :
#  - dumps des bases : MainWP, iTop, BookStack (MariaDB) et n8n (PostgreSQL)
#  - copies cohérentes des bases SQLite d'Uptime Kuma et du tableau de bord Pilotage (conteneur en pause quelques secondes)
#  - volumes Docker utiles (BookStack, MainWP, n8n, certificats Caddy)
#  - /opt/stack (compose, configurations, secrets dont la clé de chiffrement n8n), scripts et unités systemd
# Rétention : 7 jours, 4 semaines, 6 mois. Vérification de l'intégrité le dimanche.
# Fin réussie : signal envoyé à la sonde « push » d'Uptime Kuma (absence de signal = alerte).
#
# Secrets (hors dépôt git) :
#  /root/secrets/s3-sauvegardes.env   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY de l'utilisateur S3 « restic-vps »
#  /root/secrets/restic-password      mot de passe du dépôt restic (copie dans Bitwarden et hors ligne)
#  /root/secrets/kuma-push-url        URL de la sonde push Uptime Kuma (facultatif)
set -euo pipefail
umask 077

export RESTIC_REPOSITORY="s3:https://s3.gra.io.cloud.ovh.net/edelmotte-sauvegardes-vps/restic"
export RESTIC_PASSWORD_FILE=/root/secrets/restic-password
export AWS_DEFAULT_REGION=gra
export RESTIC_CACHE_DIR=/var/cache/restic
set -a; . /root/secrets/s3-sauvegardes.env; set +a

TRAVAIL=/var/backups/edelmotte
VOL=/var/lib/docker/volumes
DEBUT=$(date +%s)
journal() { echo "[$(date '+%F %T')] $*"; }

rm -rf "$TRAVAIL"; mkdir -p "$TRAVAIL/bases" "$TRAVAIL/sqlite"

# ---------- Bases MariaDB (utilisateur applicatif, mot de passe lu dans le conteneur) ----------
dump_mariadb() { # conteneur base utilisateur
  docker exec "$1" sh -c "MYSQL_PWD=\$(cat /run/secrets/db_password) mariadb-dump -u $3 --single-transaction --quick --routines --triggers --events $2" \
    | gzip -6 > "$TRAVAIL/bases/$2.sql.gz"
  journal "base $2 : $(du -h "$TRAVAIL/bases/$2.sql.gz" | cut -f1)"
}
dump_mariadb mainwp-db mainwp mainwp
dump_mariadb itop-db itop itop
dump_mariadb bookstack-db bookstack bookstack

# ---------- Base PostgreSQL de n8n ----------
docker exec n8n-db pg_dump -U n8n -Fc n8n > "$TRAVAIL/bases/n8n.pgdump"
journal "base n8n : $(du -h "$TRAVAIL/bases/n8n.pgdump" | cut -f1)"

# ---------- SQLite : copie à froid, conteneur en pause quelques secondes ----------
copie_a_froid() { # conteneur volume
  docker pause "$1" >/dev/null
  trap 'docker unpause "$1" >/dev/null 2>&1 || true' RETURN
  cp -a "$VOL/$2/_data" "$TRAVAIL/sqlite/$2"
  docker unpause "$1" >/dev/null
  journal "copie à froid $2 : $(du -sh "$TRAVAIL/sqlite/$2" | cut -f1)"
}
copie_a_froid uptime-kuma uptime-kuma_data
copie_a_froid pilotage pilotage_data

# ---------- Envoi chiffré ----------
restic backup --quiet --tag nuit --host vps-edelmotte \
  "$TRAVAIL" \
  /opt/stack \
  "$VOL/bookstack_config/_data" "$VOL/mainwp_wp/_data" "$VOL/n8n_data/_data" "$VOL/caddy_caddy_data/_data" \
  /usr/local/bin /usr/local/sbin /etc/systemd/system /etc/ovh.conf /root/.ssh \
  --exclude /opt/stack/backups \
  --exclude '/opt/stack/itop/web/log/*' \
  --exclude '/opt/stack/itop/web/data/cache-*' \
  --exclude '/opt/stack/itop/web/data/backups' \
  --exclude "$VOL/bookstack_config/_data/log" \
  --exclude "$VOL/n8n_data/_data/binaryData"
journal "envoi terminé"

# ---------- Rétention ----------
restic forget --quiet --host vps-edelmotte --tag nuit --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
journal "rétention appliquée (7 j / 4 sem. / 6 mois)"

# ---------- Contrôle d'intégrité hebdomadaire ----------
if [ "$(date +%u)" = 7 ]; then
  restic check --read-data-subset=5% >/dev/null
  journal "contrôle d'intégrité OK"
fi

rm -rf "$TRAVAIL"
DUREE=$(( $(date +%s) - DEBUT ))
STATS=$(restic stats --mode raw-data --json latest 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); print(round(d.get("total_size",0)/1048576),"Mo")' 2>/dev/null || echo "?")
journal "sauvegarde terminée en ${DUREE}s (dépôt : $STATS)"

# ---------- Signal de bonne fin à Uptime Kuma ----------
if [ -s /root/secrets/kuma-push-url ]; then
  curl -fsS -m 20 -o /dev/null "$(cat /root/secrets/kuma-push-url)?status=up&msg=OK%20${DUREE}s&ping=${DUREE}" || journal "signal Kuma non envoyé"
fi
