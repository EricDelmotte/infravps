# Envoi des e-mails du formulaire de contact via la boite OVH no-reply@e-delmotte.com
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile -
account ovh
host ssl0.ovh.net
port 465
tls_starttls off
from no-reply@e-delmotte.com
user no-reply@e-delmotte.com
passwordeval (voir secrets)
account default : ovh
